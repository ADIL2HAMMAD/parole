rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated person can access only the single document named with their uid.
    match /users/{userId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Refreshed by the server only. All signed-in learners may read the same
    // vetted source watch; client applications cannot overwrite it.
    match /content/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
